<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes the section layout experiments (`metadata/sections/*.exe`) from SectionProbe: each
    adds a section `.probe` of chosen VirtualSize, SizeOfRawData and PointerToRawData, and
    moves the probe's field data and method body into it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
